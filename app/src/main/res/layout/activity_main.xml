<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Body"
            android:text="@string/subtitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/accent"
                android:text="@string/start_overlay"
                android:textColor="#FFFFFFFF" />

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/stop_overlay" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/permissions" />

            <TextView
                android:id="@+id/perm_overlay"
                style="@style/Body" />

            <Button
                android:id="@+id/btn_perm_overlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perm_overlay_grant" />

            <TextView
                android:id="@+id/perm_notif"
                style="@style/Body" />

            <Button
                android:id="@+id/btn_perm_notif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perm_notif_grant" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/home_page" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/home_url"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textColor="@color/text" />

                <Button
                    android:id="@+id/btn_save_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/save" />
            </LinearLayout>
        </LinearLayout>

        <!-- Appearance: every control writes to Prefs and redraws the open window live. -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/appearance" />

            <TextView
                style="@style/Body"
                android:text="@string/appearance_help" />

            <TextView
                style="@style/Body"
                android:layout_marginTop="12dp"
                android:text="@string/presets" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/preset_minimal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/preset_minimal"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/preset_rounded"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/preset_rounded"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/preset_ultra"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/preset_ultra"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/preset_glass"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/preset_glass"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_rounded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/rounded_corners"
                android:textColor="@color/text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/corner_radius"
                    android:textColor="@color/text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/radius_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/radius_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="40"
                android:min="0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/border_thickness"
                    android:textColor="@color/text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/border_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/border_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="6"
                android:min="0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/shadow_intensity"
                    android:textColor="@color/text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/shadow_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/shadow_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:min="0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/window_opacity"
                    android:textColor="@color/text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/opacity_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/opacity_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:min="10" />

            <TextView
                style="@style/Body"
                android:text="@string/opacity_help" />

            <Switch
                android:id="@+id/switch_glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/glass_style"
                android:textColor="@color/text" />

            <Switch
                android:id="@+id/switch_blur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/blur_background"
                android:textColor="@color/text" />

            <TextView
                android:id="@+id/blur_note"
                style="@style/Body" />

            <Switch
                android:id="@+id/switch_compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/compact_bar"
                android:textColor="@color/text" />

            <TextView
                style="@style/Body"
                android:layout_marginTop="12dp"
                android:text="@string/theme_label" />

            <RadioGroup
                android:id="@+id/theme_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radio_dark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/theme_dark"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/radio_amoled"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/theme_amoled"
                    android:textColor="@color/text" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/brave" />

            <TextView
                android:id="@+id/brave_status"
                style="@style/Body" />

            <TextView
                android:id="@+id/freeform_status"
                style="@style/Body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_get_brave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brave_get" />

                <Button
                    android:id="@+id/btn_test_brave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brave_test" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/tips" />

            <TextView
                style="@style/Body"
                android:text="@string/tips_body" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
